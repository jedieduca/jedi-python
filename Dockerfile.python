FROM python:3.11-slim

# =========================
# UID/GID (Mantendo o padrão do seu usuário local)
# =========================
ARG UID=1002
ARG GID=1005

# Cria grupo e usuário para evitar rodar como root no container
RUN groupadd -g ${GID} appgroup \
    && useradd -u ${UID} -g ${GID} -m appuser

# Evita prompts interativos do sistema operacional
ENV DEBIAN_FRONTEND=noninteractive

# Evita que o Python gere arquivos .pyc e permite ver os logs em tempo real
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Instala ferramentas necessárias para o spaCy (git) e mlxtend (gfortran/blas)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libffi-dev \
    libssl-dev \
    default-libmysqlclient-dev \
    git \
    gfortran \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

# 🔹 DEFINE O CAMINHO EXATO QUE VOCÊ QUER DENTRO DO CONTAINER
WORKDIR /app/mad-api

# Copia os arquivos de requisitos (produção e desenvolvimento) para dentro do caminho correto
COPY app/mad-api/requirements*.txt .

# false (padrão): só as dependências de produção (requirements.txt)
# true: inclui também as ferramentas de análise (requirements-dev.txt); defina INSTALL_DEV=true no .env do dev
ARG INSTALL_DEV=false

# Atualiza e instala as dependências conforme o ambiente
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && if [ "$INSTALL_DEV" = "true" ]; then \
         pip install --no-cache-dir -r requirements-dev.txt; \
       else \
         pip install --no-cache-dir -r requirements.txt; \
       fi

# 🔹 COPIA O SEU CÓDIGO FONTE LOCAL DIRETAMENTE PARA A RAIZ /app/mad-api DO CONTAINER
COPY app/mad-api/ .

# Garante que o usuário do container gerencie essa pasta com segurança
RUN chown -R appuser:appgroup /app/mad-api

# Define que a partir de agora o container roda com o usuário seguro e limitado
USER appuser

# Força o Matplotlib a construir o cache de fontes durante o Build do container
RUN python -c "import matplotlib.pyplot"

# 🔹 ATUALIZADO: Comando padrão ajustado para a infraestrutura Gunicorn
CMD ["gunicorn", "main:app", "--bind", "0.0.0.0:8001", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", "--timeout", "300"]
